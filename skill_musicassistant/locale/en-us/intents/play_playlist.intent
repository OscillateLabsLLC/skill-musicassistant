# Play Playlist Intent - Requires explicit playlist keyword, before or after the name.
# Lines with the name first avoid (the|) because that older padacioso turns the empty
# alternative into a double space and the line never matches without "the".
play (the|) playlist {playlist}
listen to (the|) playlist {playlist}
shuffle (the|) playlist {playlist}
play {playlist} playlist
play the {playlist} playlist
(listen to|shuffle) the {playlist} playlist

# With location
play (the|) playlist {playlist} (in|on|using) (the|) {location}
listen to (the|) playlist {playlist} (in|on|using) (the|) {location}
shuffle (the|) playlist {playlist} (in|on|using) (the|) {location}
play {playlist} playlist (in|on|using) {location}
play the {playlist} playlist (in|on|using) {location}
